<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Futures Trading — Sharp Bot</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/style.css?v=6">
  <style>
    /* === Glassmorphism design tokens === */
    :root {
      --glass-bg:           rgba(18, 20, 28, 0.55);
      --glass-bg-strong:    rgba(18, 20, 28, 0.80);
      --glass-border:       rgba(255, 255, 255, 0.08);
      --glass-border-hover: rgba(255, 255, 255, 0.16);
      --glass-blur:         blur(20px) saturate(180%);
      --glass-shadow:       0 8px 32px rgba(0, 0, 0, 0.35), inset 0 1px 0 rgba(255, 255, 255, 0.04);
      --glass-shadow-hover: 0 12px 40px rgba(0, 0, 0, 0.50), inset 0 1px 0 rgba(255, 255, 255, 0.08);
      --ease-out:           cubic-bezier(0.22, 1, 0.36, 1);
    }

    /* === Card base — frosted glass with subtle top highlight === */
    .card {
      background: var(--glass-bg) !important;
      border: 1px solid var(--glass-border) !important;
      border-radius: 14px !important;
      box-shadow: var(--glass-shadow);
      backdrop-filter: var(--glass-blur);
      -webkit-backdrop-filter: var(--glass-blur);
      padding: 1.25rem;
      position: relative;
      overflow: hidden;
      transition: border-color 240ms var(--ease-out), box-shadow 240ms var(--ease-out);
    }
    .card::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0; height: 1px;
      background: linear-gradient(90deg, transparent, rgba(255,255,255,0.14), transparent);
      pointer-events: none;
    }

    /* === Stat bar — slightly larger numbers, glass effect, hover lift === */
    .fut-stat-bar { display:flex; gap:1rem; flex-wrap:wrap; margin-bottom:1.5rem; }
    .fut-stat {
      flex: 1 1 160px;
      min-width: 150px;
      background: var(--glass-bg);
      border: 1px solid var(--glass-border);
      border-radius: 14px;
      padding: 1.1rem 1.4rem;
      backdrop-filter: var(--glass-blur);
      -webkit-backdrop-filter: var(--glass-blur);
      box-shadow: var(--glass-shadow);
      position: relative;
      overflow: hidden;
      transition: transform 240ms var(--ease-out), border-color 240ms var(--ease-out), box-shadow 240ms var(--ease-out);
    }
    .fut-stat::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0; height: 1px;
      background: linear-gradient(90deg, transparent, rgba(255,255,255,0.16), transparent);
    }
    .fut-stat:hover {
      transform: translateY(-2px);
      border-color: var(--glass-border-hover);
      box-shadow: var(--glass-shadow-hover);
    }
    .fut-stat-label { font-size:0.68rem; color:var(--text2); text-transform:uppercase; letter-spacing:0.08em; margin-bottom:6px; font-weight:600; }
    .fut-stat-value { font-family:'Space Mono',monospace; font-size:1.4rem; font-weight:700; letter-spacing:-0.02em; line-height:1.1; }
    .fut-stat-value.pos { color:#00d4a0; text-shadow: 0 0 24px rgba(0,212,160,0.25); }
    .fut-stat-value.neg { color:#ff4f4f; text-shadow: 0 0 24px rgba(255,79,79,0.25); }

    /* === Tables — softer separators, subtle row hover === */
    .opt-table { width:100%; border-collapse:separate; border-spacing:0; font-size:0.84rem; }
    .opt-table th {
      text-align:left; padding:10px 14px;
      color:var(--text2); font-weight:600; font-size:0.66rem;
      text-transform:uppercase; letter-spacing:0.08em;
      border-bottom:1px solid var(--glass-border);
      background: rgba(255,255,255,0.02);
    }
    .opt-table td {
      padding:11px 14px;
      border-bottom:1px solid rgba(255,255,255,0.04);
    }
    .opt-table tbody tr { transition: background 160ms var(--ease-out); }
    .opt-table tbody tr:hover { background: rgba(255,255,255,0.025); }
    tr.row-profit td { color:#00d4a0; }
    tr.row-loss   td { color:#ff4f4f; }

    /* === Badges — refined glass chips === */
    .badge {
      display:inline-block; font-size:0.62rem;
      padding:3px 9px; border-radius:6px;
      font-weight:700; text-transform:uppercase; letter-spacing:0.06em;
      backdrop-filter: blur(4px);
      border: 1px solid rgba(255,255,255,0.06);
    }
    .b-long  { background:rgba(0,212,160,0.16);  color:#00d4a0; border-color:rgba(0,212,160,0.30); }
    .b-short { background:rgba(255,79,79,0.16);  color:#ff4f4f; border-color:rgba(255,79,79,0.30); }
    .b-vwap  { background:rgba(100,180,255,0.16); color:#64b4ff; border-color:rgba(100,180,255,0.30); }
    .b-orb   { background:rgba(200,130,255,0.16); color:#c882ff; border-color:rgba(200,130,255,0.30); }
    .b-open  { background:rgba(0,212,160,0.16);  color:#00d4a0; border-color:rgba(0,212,160,0.30); }
    .b-live  {
      background: linear-gradient(135deg, rgba(245,166,35,0.22), rgba(245,166,35,0.10));
      color: #ffb84d;
      border-color: rgba(245,166,35,0.45);
      box-shadow: 0 0 12px rgba(245,166,35,0.25);
      font-weight: 700;
    }

    /* === Section header — accent glow === */
    .sect-hdr {
      font-size:0.78rem; font-weight:700;
      color:var(--accent);
      margin:0 0 0.85rem;
      text-transform:uppercase; letter-spacing:0.10em;
      text-shadow: 0 0 20px rgba(100, 180, 255, 0.25);
    }

    /* === Offline bar — keep the warning feel === */
    .offline-bar {
      background:rgba(255,79,79,0.08);
      border:1px solid rgba(255,79,79,0.30);
      border-radius:12px;
      padding:0.85rem 1.1rem;
      font-size:0.82rem; color:#ff4f4f;
      margin-bottom:1.25rem;
      backdrop-filter: blur(12px);
    }

    /* === Details (collapsible) === */
    details summary {
      cursor:pointer; color:var(--text2);
      font-size:0.82rem; padding:6px 0;
      user-select:none;
      transition: color 160ms var(--ease-out);
    }
    details summary:hover { color:var(--text); }
    details[open] summary { color:var(--accent); }

    /* === Unrealized P&L bars === */
    .pnl-bar-wrap { width:90px; height:6px; background:rgba(255,255,255,0.06); border-radius:3px; margin-top:5px; overflow:hidden; }
    .pnl-bar-fill { height:6px; border-radius:3px; transition: width 300ms var(--ease-out); }
    .pnl-bar-fill.profit { background: linear-gradient(90deg, #00b88a, #00d4a0); box-shadow: 0 0 12px rgba(0,212,160,0.5); }
    .pnl-bar-fill.loss   { background: linear-gradient(90deg, #cc3a3a, #ff4f4f); box-shadow: 0 0 12px rgba(255,79,79,0.5); }

    /* === Calendar — glass cells with smooth lift === */
    .cal-header { display:flex; justify-content:space-between; align-items:center; margin-bottom:0.85rem; flex-wrap:wrap; gap:0.5rem; }
    .cal-month  { font-size:1.05rem; font-weight:700; color:var(--text); letter-spacing:-0.01em; }
    .cal-legend { display:flex; gap:0.85rem; font-size:0.7rem; color:var(--text2); align-items:center; }
    .cal-legend-dot { display:inline-block; width:8px; height:8px; border-radius:2px; margin-right:4px; vertical-align:middle; }
    .cal-grid { display:grid; grid-template-columns:repeat(7,1fr); gap:5px; }
    .cal-dow { text-align:center; font-size:0.62rem; color:var(--text2); padding:6px 0 4px; text-transform:uppercase; letter-spacing:0.08em; font-weight:600; }
    .cal-cell {
      background: rgba(255, 255, 255, 0.025);
      border: 1px solid var(--glass-border);
      border-radius: 9px;
      min-height: 78px;
      padding: 7px 8px;
      position: relative;
      backdrop-filter: blur(8px);
      transition: transform 200ms var(--ease-out), border-color 200ms var(--ease-out), box-shadow 200ms var(--ease-out);
    }
    .cal-cell.empty { background: transparent; border: none; }
    .cal-cell.today {
      box-shadow: 0 0 0 1px var(--accent) inset, 0 0 20px rgba(100, 180, 255, 0.20);
    }
    .cal-cell.profit {
      background: linear-gradient(135deg, rgba(0,212,160,0.12), rgba(0,212,160,0.06));
      border-color: rgba(0,212,160,0.32);
    }
    .cal-cell.loss {
      background: linear-gradient(135deg, rgba(255,79,79,0.12), rgba(255,79,79,0.06));
      border-color: rgba(255,79,79,0.32);
    }
    .cal-cell.flat { background: rgba(180,180,180,0.05); }
    .cal-day { font-size:0.72rem; font-weight:700; color:var(--text2); line-height:1; }
    .cal-cell.today .cal-day { color:var(--accent); }
    .cal-wl { font-size:0.66rem; font-family:'Space Mono',monospace; margin-top:5px; line-height:1.1; }
    .cal-w { color:#00d4a0; font-weight:700; }
    .cal-l { color:#ff4f4f; font-weight:700; margin-left:6px; }
    .cal-net { font-family:'Space Mono',monospace; font-size:0.76rem; font-weight:700; margin-top:4px; line-height:1; letter-spacing:-0.01em; }
    .cal-net.profit { color:#00d4a0; }
    .cal-net.loss   { color:#ff4f4f; }
    .cal-net.flat   { color:var(--text2); }
    .cal-cell.clickable { cursor:pointer; }
    .cal-cell.clickable:hover {
      transform: translateY(-3px) scale(1.02);
      border-color: var(--glass-border-hover);
      box-shadow: 0 10px 28px rgba(0,0,0,0.35);
    }
    .cal-cell.clickable.profit:hover { box-shadow: 0 10px 28px rgba(0,212,160,0.25); }
    .cal-cell.clickable.loss:hover   { box-shadow: 0 10px 28px rgba(255,79,79,0.25); }

    /* === Modal — heavier glass with soft entrance === */
    .day-modal-backdrop {
      display: none;
      position: fixed; inset: 0;
      background: rgba(0, 0, 0, 0.45);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      z-index: 1000;
      align-items: center; justify-content: center;
      padding: 1.5rem;
    }
    .day-modal-backdrop.open { display: flex; animation: modalFade 240ms var(--ease-out); }
    @keyframes modalFade { from { opacity: 0; } to { opacity: 1; } }
    .day-modal {
      background: var(--glass-bg-strong);
      border: 1px solid var(--glass-border);
      border-radius: 18px;
      max-width: 780px; width: 100%;
      max-height: 85vh;
      overflow: hidden;
      display: flex; flex-direction: column;
      box-shadow: 0 24px 80px rgba(0, 0, 0, 0.7), inset 0 1px 0 rgba(255, 255, 255, 0.08);
      backdrop-filter: blur(40px) saturate(180%);
      -webkit-backdrop-filter: blur(40px) saturate(180%);
      animation: modalRise 320ms var(--ease-out);
    }
    @keyframes modalRise { from { opacity: 0; transform: translateY(20px) scale(0.96); } to { opacity: 1; transform: translateY(0) scale(1); } }
    .day-modal-header {
      padding: 1.1rem 1.4rem;
      border-bottom: 1px solid var(--glass-border);
      display: flex; justify-content: space-between; align-items: center;
    }
    .day-modal-title { font-size: 1.05rem; font-weight: 700; letter-spacing: -0.01em; }
    .day-modal-close {
      background: none; border: none;
      color: var(--text2); font-size: 1.5rem;
      cursor: pointer; padding: 0 0.4rem; line-height: 1;
      transition: color 160ms var(--ease-out);
    }
    .day-modal-close:hover { color: var(--text); }
    .day-modal-body { padding: 1.1rem 1.4rem; overflow-y: auto; }
    .day-modal-summary { display: flex; gap: 1.25rem; font-size: 0.8rem; margin-bottom: 1.1rem; flex-wrap: wrap; }
    .day-modal-summary span { color: var(--text2); }
    .day-section-label { font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.10em; margin: 1.1rem 0 0.6rem; }
    .day-section-label.wins   { color: #00d4a0; }
    .day-section-label.losses { color: #ff4f4f; }
    .day-section-label:first-child { margin-top: 0; }

    /* === Focus states for accessibility === */
    button:focus-visible, a:focus-visible, .cal-cell.clickable:focus-visible {
      outline: 2px solid rgba(100, 180, 255, 0.6);
      outline-offset: 2px;
      border-radius: 8px;
    }

    /* === Live indicator dot (top of page) === */
    .live-indicator {
      display: inline-flex; align-items: center; gap: 8px;
      padding: 6px 12px;
      background: rgba(0, 212, 160, 0.08);
      border: 1px solid rgba(0, 212, 160, 0.30);
      border-radius: 999px;
      font-size: 0.72rem; color: var(--text2);
      font-family: 'Space Mono', monospace;
      backdrop-filter: blur(8px);
    }
    .live-dot {
      width: 8px; height: 8px;
      border-radius: 50%;
      background: #00d4a0;
      box-shadow: 0 0 8px rgba(0,212,160,0.6);
    }
    .live-dot.pulse { animation: livePulse 600ms var(--ease-out); }
    @keyframes livePulse {
      0%   { transform: scale(1);   box-shadow: 0 0 8px rgba(0,212,160,0.6); }
      40%  { transform: scale(1.8); box-shadow: 0 0 16px rgba(0,212,160,0.9); }
      100% { transform: scale(1);   box-shadow: 0 0 8px rgba(0,212,160,0.6); }
    }
    .live-age { color: var(--text2); font-size: 0.68rem; letter-spacing: 0.04em; }

    /* === Smooth scrolling === */
    html { scroll-behavior: smooth; }

    /* === Respect reduced motion === */
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: 0.01ms !important;
        transition-duration: 0.01ms !important;
      }
    }
  </style>
</head>
<body>
  <%
  function money(n) {
    if (n == null) return '—';
    const v = parseFloat(n);
    return (v < 0 ? '-$' : '$') + Math.abs(v).toLocaleString('en-US', {minimumFractionDigits:2, maximumFractionDigits:2});
  }
  function pclass(n) { return n == null ? '' : parseFloat(n) >= 0 ? 'pos' : 'neg'; }
  function dirBadge(d) {
    if (d === 'long')  return '<span class="badge b-long">Long</span>';
    if (d === 'short') return '<span class="badge b-short">Short</span>';
    return '<span class="badge">' + (d||'?') + '</span>';
  }
  function stratBadge(s) {
    if (s === 'vwap') return '<span class="badge b-vwap">VWAP</span>';
    if (s === 'orb')  return '<span class="badge b-orb">ORB</span>';
    return '<span class="badge">' + (s||'?') + '</span>';
  }
  function liveBadge(t) {
    // A trade is "live traded" when its broker order_id is not the sim sentinel.
    // 'SIM' is set by trader.py when sim mode is on; real broker fills have a real ID.
    const id = t && t.order_id;
    if (!id || id === 'SIM') return '';
    return '<span class="badge b-live" title="Order id ' + id + '">● Live</span>';
  }
  %>

  <div id="vanta-bg"></div>
  <nav class="navbar">
    <div class="nav-brand">⚡ Sharp Bot</div>
    <div class="nav-links">
      <div class="nav-dropdown">
        <button class="nav-dropdown-trigger">Predictions <span class="dd-arrow">▼</span></button>
        <div class="nav-dropdown-menu">
          <a href="/">Dashboard</a>
          <a href="/history">History</a>
          <a href="/spreads">Spreads</a>
          <a href="/portfolio">Portfolio</a>
        </div>
      </div>
      <div class="nav-dropdown">
        <button class="nav-dropdown-trigger active">Trading <span class="dd-arrow">▼</span></button>
        <div class="nav-dropdown-menu">
          <a href="/options">Options</a>
          <a href="/futures" class="active">Futures</a>
          <a href="/crypto">Crypto</a>
        </div>
      </div>
      <a href="/settings">Settings</a>
      <% if (user.role === 'admin') { %><a href="/admin">Admin</a><% } %>
    </div>
    <div class="nav-right">
      <span class="nav-user">@<%= user.username %></span>
      <a href="/auth/logout" class="btn-logout">Logout</a>
    </div>
  </nav>

  <div id="live-content" class="container" style="padding-top:2rem;">
    <div class="page-header" style="display:flex;align-items:center;justify-content:space-between;gap:1rem;flex-wrap:wrap;">
      <h2 style="margin:0;">Futures Trading</h2>
      <span class="live-indicator">
        <span id="liveDot" class="live-dot pulse"></span>
        <span>LIVE</span>
        <span class="live-age">·</span>
        <span id="liveAge" class="live-age">just now</span>
      </span>
    </div>

    <% if (!botOnline) { %>
    <div class="offline-bar">Bot offline — run <code>python -m bot.futures.main</code> to start. Configure credentials in <a href="/settings" style="color:#ff4f4f">Settings</a>.</div>
    <% } %>

    <!-- Trading Controls -->
    <div style="display:flex;align-items:center;gap:1rem;margin-bottom:1.25rem;">
      <% if (tradingPaused) { %>
        <button id="tradeToggleBtn" onclick="toggleTrading()" style="background:rgba(0,212,160,0.15);border:1px solid rgba(0,212,160,0.5);color:#00d4a0;font-size:0.82rem;padding:8px 20px;border-radius:7px;cursor:pointer;font-weight:700;letter-spacing:0.04em;">▶ Start Trading</button>
        <span style="font-size:0.78rem;color:#f5a623;font-weight:600;">⏸ Trading Paused</span>
      <% } else { %>
        <button id="tradeToggleBtn" onclick="toggleTrading()" style="background:rgba(255,79,79,0.15);border:1px solid rgba(255,79,79,0.5);color:#ff4f4f;font-size:0.82rem;padding:8px 20px;border-radius:7px;cursor:pointer;font-weight:700;letter-spacing:0.04em;">⏹ Stop Trading</button>
        <span style="font-size:0.78rem;color:#00d4a0;font-weight:600;">● Trading Active</span>
      <% } %>
    </div>

    <!-- Account Stats -->
    <div id="live-stats" class="fut-stat-bar">
      <div class="fut-stat">
        <div class="fut-stat-label">NET LIQ</div>
        <div class="fut-stat-value <%= netLiq != null ? pclass(netLiq) : '' %>">
          <%= netLiq != null ? money(netLiq) : '—' %>
        </div>
      </div>
      <div class="fut-stat">
        <div class="fut-stat-label">Today P&amp;L</div>
        <div class="fut-stat-value <%= pclass(todayPnl) %>">
          <%= todayPnl != null ? (todayPnl >= 0 ? '+' : '') + money(todayPnl) : '—' %>
        </div>
      </div>
      <div class="fut-stat">
        <div class="fut-stat-label">All-time P&amp;L</div>
        <div class="fut-stat-value <%= pclass(allTimePnl) %>">
          <%= allTimePnl != null ? (allTimePnl >= 0 ? '+' : '') + money(allTimePnl) : '—' %>
        </div>
      </div>
      <div class="fut-stat">
        <div class="fut-stat-label">Open Positions</div>
        <div class="fut-stat-value"><%= openTrades ? openTrades.length : 0 %></div>
      </div>
    </div>

    <!-- Market Status -->
    <div id="live-market-status">
    <% if (marketStatus) {
      const symbols = ['ES','NQ'];
      const sessionLabel = marketStatus._session === 'orb' ? '🟡 ORB Window (9:30–10:00 AM)' : '🟢 Active';
      const ts = marketStatus._ts ? new Date(marketStatus._ts).toLocaleTimeString([],{hour:'2-digit',minute:'2-digit',second:'2-digit'}) : '—';
    %>
    <div class="card" style="margin-bottom:1.25rem;">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:0.9rem;">
        <p class="sect-hdr" style="margin:0;">Market Status</p>
        <span style="font-size:0.72rem;color:var(--text2);">updated <%= ts %> · auto-refresh 15s</span>
      </div>
      <% const _halted = symbols.some(sym => marketStatus[sym] && marketStatus[sym].halted); %>
      <% if (_halted) { %>
      <div style="background:rgba(255,79,79,0.14);border:1px solid rgba(255,79,79,0.4);border-radius:10px;padding:0.7rem 1rem;margin-bottom:0.9rem;color:#ff4f4f;font-weight:600;font-size:0.82rem;">
        ⛔ Trading HALTED — drawdown guard active (account near its trailing floor, or locked). New entries blocked; open positions stay managed by their stops.
      </div>
      <% } %>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:0.9rem;">
        <% for (const sym of symbols) {
          const s = marketStatus[sym];
          if (!s) continue;
          const dev = s.dev_pct;
          const thr = s.threshold;
          const pctLeft = dev != null && thr ? Math.max(0, thr - Math.abs(dev)) : null;
          const progress = dev != null && thr ? Math.min(100, Math.abs(dev) / thr * 100) : 0;
          const barColor = progress >= 100 ? '#00d4a0' : progress >= 70 ? '#f5a623' : '#64b4ff';
          const trendColor = s.trend === 'up' ? '#00d4a0' : s.trend === 'down' ? '#ff4f4f' : 'var(--text2)';
          const trendArrow = s.trend === 'up' ? '▲' : s.trend === 'down' ? '▼' : '—';
          const sessionTag = s.session === 'orb' ? '<span style="font-size:0.68rem;color:#f5a623;">ORB Building</span>' : '';
        %>
        <div style="background:rgba(255,255,255,0.03);border:1px solid var(--border);border-radius:10px;padding:1rem;">
          <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:0.5rem;">
            <span style="font-weight:700;font-size:1rem;"><%= sym %></span>
            <span style="font-family:'Space Mono',monospace;font-size:0.9rem;"><%= s.price != null ? s.price.toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2}) : '—' %></span>
          </div>
          <% if (s.session === 'orb') { %>
            <div style="font-size:0.76rem;color:#f5a623;margin-bottom:0.4rem;">📊 Building opening range…</div>
            <% if (s.orb_high) { %><div style="font-size:0.74rem;color:var(--text2);">High: <span style="color:#00d4a0;font-family:'Space Mono',monospace;"><%= s.orb_high.toFixed(2) %></span> &nbsp; Low: <span style="color:#ff4f4f;font-family:'Space Mono',monospace;"><%= s.orb_low ? s.orb_low.toFixed(2) : '—' %></span></div><% } %>
          <% } else { %>
            <!-- Deviation bar -->
            <div style="font-size:0.72rem;color:var(--text2);margin-bottom:3px;">
              VWAP deviation: <span style="color:<%= barColor %>;font-weight:600;"><%= dev != null ? (dev >= 0 ? '+' : '') + dev.toFixed(3) + '%' : '—' %></span>
              <span style="color:var(--text2);"> / need <%= thr ? thr.toFixed(2) + '%' : '—' %></span>
            </div>
            <div style="height:5px;background:rgba(255,255,255,0.08);border-radius:3px;margin-bottom:0.55rem;">
              <div style="height:5px;width:<%= progress.toFixed(0) %>%;background:<%= barColor %>;border-radius:3px;transition:width 0.4s;"></div>
            </div>
            <!-- RSI + Trend -->
            <div style="display:flex;gap:1rem;font-size:0.74rem;">
              <span style="color:var(--text2);">RSI <span style="color:<%= s.rsi != null && s.rsi > 70 ? '#f5a623' : s.rsi != null && s.rsi < 30 ? '#f5a623' : 'var(--text)' %>;font-weight:600;"><%= s.rsi != null ? s.rsi.toFixed(0) : '—' %></span></span>
              <span style="color:var(--text2);">Trend <span style="color:<%= trendColor %>;font-weight:600;"><%= trendArrow %> <%= s.trend || '—' %></span></span>
            </div>
            <!-- Order flow: cumulative volume delta (60s) + top-of-book imbalance -->
            <% if (s.cvd != null) { const cvdColor = s.cvd > 0 ? '#00d4a0' : s.cvd < 0 ? '#ff4f4f' : 'var(--text2)'; %>
            <div style="margin-top:0.4rem;font-size:0.72rem;color:var(--text2);">
              Order flow <span style="color:<%= cvdColor %>;font-weight:700;font-family:'Space Mono',monospace;"><%= s.cvd > 0 ? '+' : '' %><%= s.cvd %></span>
              <span style="color:<%= cvdColor %>;"><%= s.cvd > 0 ? '▲ buying' : s.cvd < 0 ? '▼ selling' : '— flat' %></span>
            </div>
            <% } %>
            <% if (s.imbalance != null) { const ic = s.imbalance > 0.15 ? '#00d4a0' : s.imbalance < -0.15 ? '#ff4f4f' : 'var(--text2)'; %>
            <div style="margin-top:0.2rem;font-size:0.72rem;color:var(--text2);">
              Book imbalance <span style="color:<%= ic %>;font-weight:700;font-family:'Space Mono',monospace;"><%= s.imbalance > 0 ? '+' : '' %><%= (s.imbalance*100).toFixed(0) %>%</span>
              <span style="color:<%= ic %>;"><%= s.imbalance > 0.15 ? 'bid-heavy' : s.imbalance < -0.15 ? 'ask-heavy' : 'balanced' %></span>
            </div>
            <% } %>
            <!-- Session reference levels -->
            <% if (s.levels && (s.levels.prior_day_high || s.levels.overnight_high)) { const lv = s.levels; %>
            <div style="margin-top:0.35rem;font-size:0.68rem;color:var(--text2);line-height:1.6;">
              <% if (lv.prior_day_high) { %>Prior day <span style="color:#ff4f4f;font-family:'Space Mono',monospace;"><%= lv.prior_day_low.toFixed(2) %></span> – <span style="color:#00d4a0;font-family:'Space Mono',monospace;"><%= lv.prior_day_high.toFixed(2) %></span><br><% } %>
              <% if (lv.overnight_high) { %>Overnight <span style="color:#ff4f4f;font-family:'Space Mono',monospace;"><%= lv.overnight_low.toFixed(2) %></span> – <span style="color:#00d4a0;font-family:'Space Mono',monospace;"><%= lv.overnight_high.toFixed(2) %></span><% } %>
            </div>
            <% } %>
            <% if (s.day_type) {
                 const dtMap = {
                   trend_day_up:     {emoji:'⬆️',  label:'Trend Day Up',     color:'#00d4a0'},
                   trend_day_down:   {emoji:'⬇️',  label:'Trend Day Down',   color:'#ff4f4f'},
                   gap_and_go_up:    {emoji:'🚀', label:'Gap-and-Go Up',    color:'#00d4a0'},
                   gap_and_go_down:  {emoji:'🔻', label:'Gap-and-Go Down',  color:'#ff4f4f'},
                   auction_reversal: {emoji:'↩️',  label:'Auction Reversal', color:'#f5a623'},
                   news_expansion:   {emoji:'⚡', label:'News Expansion',   color:'#f5a623'},
                   low_vol_chop:     {emoji:'💤', label:'Low-Vol Chop',     color:'#888'},
                   balance_day:      {emoji:'🌀', label:'Balance Day',      color:'#64b4ff'},
                 };
                 const dt = dtMap[s.day_type] || {emoji:'•', label: s.day_type, color:'var(--text2)'};
            %>
            <div style="margin-top:0.4rem;font-size:0.72rem;color:var(--text2);">
              Day type:
              <span style="color:<%= dt.color %>;font-weight:600;"><%= dt.emoji %> <%= dt.label %></span>
            </div>
            <% } %>
            <% if (s.confidence_long != null || s.confidence_short != null) {
                 function confColor(c) {
                   return c >= 75 ? '#00d4a0' : c >= 60 ? '#64b4ff' : c >= 40 ? '#f5a623' : '#ff4f4f';
                 }
                 const cl = s.confidence_long;
                 const cs = s.confidence_short;
                 const activeDir = s.conf_dir;
                 const longActive  = activeDir === 'long';
                 const shortActive = activeDir === 'short';
            %>
            <div style="margin-top:0.6rem;display:grid;grid-template-columns:1fr 1fr;gap:6px;">
              <!-- LONG -->
              <div style="padding:0.5rem 0.65rem;background:<%= longActive ? 'rgba(0,212,160,0.12)' : 'rgba(255,255,255,0.025)' %>;border:1px solid <%= longActive ? 'rgba(0,212,160,0.45)' : 'rgba(255,255,255,0.08)' %>;border-radius:8px;<%= longActive ? 'box-shadow:0 0 12px rgba(0,212,160,0.18);' : '' %>">
                <div style="display:flex;justify-content:space-between;align-items:center;font-size:0.68rem;color:var(--text2);">
                  <span style="text-transform:uppercase;letter-spacing:0.06em;font-weight:600;<%= longActive ? 'color:#00d4a0;' : '' %>">Long<%= longActive ? ' ●' : '' %></span>
                  <span style="color:<%= cl != null ? confColor(cl) : 'var(--text2)' %>;font-weight:700;font-family:'Space Mono',monospace;font-size:0.92rem;letter-spacing:-0.02em;"><%= cl != null ? cl : '—' %>/100</span>
                </div>
                <% if (s.conf_break_long) { %>
                <div style="margin-top:4px;font-size:0.58rem;color:var(--text2);font-family:'Space Mono',monospace;line-height:1.4;">
                  d<%= s.conf_break_long.dev %> t<%= s.conf_break_long.trend %> day<%= s.conf_break_long.day_type %> r<%= s.conf_break_long.rsi %> a<%= s.conf_break_long.atr %> n<%= s.conf_break_long.news %>
                </div>
                <% } %>
              </div>
              <!-- SHORT -->
              <div style="padding:0.5rem 0.65rem;background:<%= shortActive ? 'rgba(255,79,79,0.12)' : 'rgba(255,255,255,0.025)' %>;border:1px solid <%= shortActive ? 'rgba(255,79,79,0.45)' : 'rgba(255,255,255,0.08)' %>;border-radius:8px;<%= shortActive ? 'box-shadow:0 0 12px rgba(255,79,79,0.18);' : '' %>">
                <div style="display:flex;justify-content:space-between;align-items:center;font-size:0.68rem;color:var(--text2);">
                  <span style="text-transform:uppercase;letter-spacing:0.06em;font-weight:600;<%= shortActive ? 'color:#ff4f4f;' : '' %>">Short<%= shortActive ? ' ●' : '' %></span>
                  <span style="color:<%= cs != null ? confColor(cs) : 'var(--text2)' %>;font-weight:700;font-family:'Space Mono',monospace;font-size:0.92rem;letter-spacing:-0.02em;"><%= cs != null ? cs : '—' %>/100</span>
                </div>
                <% if (s.conf_break_short) { %>
                <div style="margin-top:4px;font-size:0.58rem;color:var(--text2);font-family:'Space Mono',monospace;line-height:1.4;">
                  d<%= s.conf_break_short.dev %> t<%= s.conf_break_short.trend %> day<%= s.conf_break_short.day_type %> r<%= s.conf_break_short.rsi %> a<%= s.conf_break_short.atr %> n<%= s.conf_break_short.news %>
                </div>
                <% } %>
              </div>
            </div>
            <% } %>
            <% if (s.news_state && s.news_state !== 'normal') { %>
            <div style="margin-top:0.3rem;font-size:0.72rem;">
              <% if (s.news_state === 'pause') { %>
                <span style="color:#ff4f4f;font-weight:700;">🛑 NEWS PAUSE</span>
              <% } else if (s.news_state === 'near_event') { %>
                <span style="color:#f5a623;font-weight:600;">⚡ NEAR EVENT — size halved, stop wider, target tighter</span>
              <% } %>
            </div>
            <% } %>
            <!-- Signal state -->
            <div style="margin-top:0.5rem;font-size:0.74rem;">
              <% if (s.signal) { %>
                <span style="color:#00d4a0;font-weight:700;">⚡ SIGNAL: <%= s.signal.toUpperCase() %></span>
              <% } else if (s.blocked_by && s.blocked_by.startsWith('pending ')) { %>
                <span style="color:#64b4ff;font-weight:600;">🎯 armed <%= s.blocked_by.replace('pending ', '') %></span>
              <% } else if (s.blocked_by) { %>
                <span style="color:#f5a623;">⛔ blocked by <%= s.blocked_by %></span>
              <% } else if (pctLeft != null) { %>
                <span style="color:var(--text2);">needs +<%= pctLeft.toFixed(3) %>% more to fire</span>
              <% } else { %>
                <span style="color:var(--text2);">—</span>
              <% } %>
            </div>
          <% } %>
        </div>
        <% } %>
      </div>
    </div>
    <% } %>
    </div>

    <!-- Recent Fills (real-time from TopStep User Hub) -->
    <% if (typeof recentFills !== 'undefined' && recentFills && recentFills.length) { %>
    <div class="card" style="margin-bottom:1.25rem;">
      <p class="sect-hdr">Recent Fills <span style="font-size:0.7rem;color:var(--text2);font-weight:400;">· live from TopStep</span></p>
      <div style="overflow-x:auto;">
        <table class="opt-table">
          <thead><tr><th>Time</th><th>Symbol</th><th>Side</th><th>Size</th><th>Price</th><th>P&amp;L</th><th>Fees</th></tr></thead>
          <tbody>
          <% recentFills.slice(0,12).forEach(f => {
               const sideColor = f.side === 'buy' ? '#00d4a0' : '#ff4f4f';
               const pnlColor = f.pnl == null ? 'var(--text2)' : (f.pnl >= 0 ? '#00d4a0' : '#ff4f4f');
               const sym = (f.contractId||'').includes('ENQ') ? 'NQ' : ((f.contractId||'').includes('EP') ? 'ES' : ((f.contractId||'').split('.').pop()||'—'));
               const tt = f.ts ? new Date(f.ts).toLocaleTimeString([],{hour:'2-digit',minute:'2-digit',second:'2-digit'}) : '—';
          %>
            <tr>
              <td style="color:var(--text2);font-family:'Space Mono',monospace;"><%= tt %></td>
              <td style="font-weight:600;"><%= sym %></td>
              <td style="color:<%= sideColor %>;font-weight:600;"><%= (f.side||'').toUpperCase() %></td>
              <td><%= f.size != null ? f.size : '—' %></td>
              <td style="font-family:'Space Mono',monospace;"><%= f.price != null ? Number(f.price).toFixed(2) : '—' %></td>
              <td style="color:<%= pnlColor %>;font-family:'Space Mono',monospace;"><%= f.pnl != null ? (f.pnl>=0?'+':'')+'$'+Number(f.pnl).toFixed(2) : '—' %></td>
              <td style="color:var(--text2);font-family:'Space Mono',monospace;"><%= f.fees != null ? '$'+Number(f.fees).toFixed(2) : '—' %></td>
            </tr>
          <% }) %>
          </tbody>
        </table>
      </div>
    </div>
    <% } %>

    <!-- Open Positions -->
    <div id="live-open-positions" class="card" style="margin-bottom:1.25rem;">
      <p class="sect-hdr">Open Positions</p>
      <% if (openTrades && openTrades.length > 0) { %>
      <div style="overflow-x:auto;">
        <table class="opt-table">
          <thead>
            <tr>
              <th>Symbol</th><th>Mode</th><th>Strategy</th><th>Direction</th>
              <th>Entry</th><th>Current</th><th>Stop</th><th>Target</th>
              <th>Unrealized P&amp;L</th><th>Status</th><th></th>
            </tr>
          </thead>
          <tbody>
            <% for (const t of openTrades) { %>
            <%
              const curr  = t.current_price != null ? parseFloat(t.current_price) : null;
              const entry = parseFloat(t.entry_price);
              const pv    = t.symbol === 'NQ' ? 20 : (t.symbol === 'RTY' ? 50 : 50);
              const unreal = curr != null
                ? (t.direction === 'long' ? curr - entry : entry - curr) * t.contracts * pv
                : null;
            %>
            <tr>
              <td style="font-weight:700;"><%= t.symbol %></td>
              <td><%- liveBadge(t) || '<span class="badge" style="opacity:0.5;">Sim</span>' %></td>
              <td><%- stratBadge(t.strategy) %></td>
              <td><%- dirBadge(t.direction) %></td>
              <td style="font-family:'Space Mono',monospace;"><%= entry.toFixed(2) %></td>
              <td style="font-family:'Space Mono',monospace;"><%= curr != null ? curr.toFixed(2) : '—' %></td>
              <td style="font-family:'Space Mono',monospace;color:var(--text2);"><%= parseFloat(t.stop_price).toFixed(2) %></td>
              <td style="font-family:'Space Mono',monospace;color:var(--text2);"><%= parseFloat(t.target_price).toFixed(2) %></td>
              <td style="font-family:'Space Mono',monospace;font-weight:700;">
                <% if (unreal != null) { %>
                  <span style="color:<%= unreal >= 0 ? '#00d4a0' : '#ff4f4f' %>">
                    <%= unreal >= 0 ? '+' : '' %><%= money(unreal) %>
                  </span>
                  <div class="pnl-bar-wrap">
                    <div class="pnl-bar-fill <%= unreal >= 0 ? 'profit' : 'loss' %>" style="width:<%= Math.min(100, Math.abs(unreal)/200*100) %>%"></div>
                  </div>
                <% } else { %>—<% } %>
              </td>
              <td><span class="badge b-open">Open</span></td>
              <td>
                <button onclick="closeTrade(<%= t.id %>)" style="background:rgba(255,79,79,0.15);border:1px solid rgba(255,79,79,0.4);color:#ff4f4f;font-size:0.72rem;padding:4px 10px;border-radius:5px;cursor:pointer;font-weight:700;">Close Now</button>
              </td>
            </tr>
            <% } %>
          </tbody>
        </table>
      </div>
      <% } else { %>
      <p style="color:var(--text2);font-size:0.82rem;padding:0.5rem 0;">No open positions.</p>
      <% } %>
    </div>

    <!-- Signal Feed -->
    <div class="card" style="margin-bottom:1.25rem;">
      <p class="sect-hdr">Signal Feed</p>
      <% if (recentSignals && recentSignals.length > 0) { %>
      <div style="overflow-x:auto;">
        <table class="opt-table">
          <thead>
            <tr>
              <th>Time</th><th>Symbol</th><th>Strategy</th><th>Direction</th>
              <th>Price</th><th>VWAP</th><th>ORB High</th><th>ORB Low</th><th></th>
            </tr>
          </thead>
          <tbody>
            <% for (const s of recentSignals) { %>
            <tr>
              <td style="color:var(--text2);font-family:'Space Mono',monospace;font-size:0.75rem;">
                <%= s.ts ? new Date(s.ts).toLocaleTimeString([],{hour:'2-digit',minute:'2-digit',second:'2-digit'}) : '—' %>
              </td>
              <td style="font-weight:700;"><%= s.symbol %></td>
              <td><%- stratBadge(s.strategy) %></td>
              <td><%- dirBadge(s.direction) %></td>
              <td style="font-family:'Space Mono',monospace;"><%= s.price != null ? parseFloat(s.price).toFixed(2) : '—' %></td>
              <td style="font-family:'Space Mono',monospace;color:var(--text2);"><%= s.vwap != null ? parseFloat(s.vwap).toFixed(2) : '—' %></td>
              <td style="font-family:'Space Mono',monospace;color:var(--text2);"><%= (s.orb_high != null && isFinite(s.orb_high)) ? parseFloat(s.orb_high).toFixed(2) : '—' %></td>
              <td style="font-family:'Space Mono',monospace;color:var(--text2);"><%= (s.orb_low  != null && isFinite(s.orb_low))  ? parseFloat(s.orb_low).toFixed(2)  : '—' %></td>
              <td><% if (s.traded == 1) { %><span class="badge b-open">Traded</span><% } %></td>
            </tr>
            <% } %>
          </tbody>
        </table>
      </div>
      <% } else { %>
      <p style="color:var(--text2);font-size:0.82rem;padding:0.5rem 0;">No signals yet. Bot scans every 45 seconds (closed 5–6 PM ET only).</p>
      <% } %>
    </div>

    <!-- News & Events -->
    <div class="card" style="margin-bottom:1.25rem;">
      <p class="sect-hdr">News &amp; Events</p>
      <% if (recentNews && recentNews.length > 0) { %>
      <div style="overflow-x:auto;">
        <table class="opt-table">
          <thead>
            <tr><th>Time</th><th>Type</th><th>Title</th><th>Impact / Sentiment</th></tr>
          </thead>
          <tbody>
            <% for (const n of recentNews) { %>
            <tr>
              <td style="color:var(--text2);font-family:'Space Mono',monospace;font-size:0.75rem;white-space:nowrap;">
                <%= n.event_ts ? new Date(n.event_ts).toLocaleString([],{month:'short',day:'numeric',hour:'2-digit',minute:'2-digit'}) : '—' %>
              </td>
              <td>
                <% if (n.news_type === 'event') { %>
                  <span class="badge" style="background:rgba(245,166,35,0.12);color:#f5a623;">EVENT</span>
                <% } else { %>
                  <span class="badge" style="background:rgba(100,180,255,0.12);color:#64b4ff;">NEWS</span>
                <% } %>
              </td>
              <td style="font-size:0.80rem;max-width:420px;">
                <% if (n.url) { %>
                  <a href="<%- n.url %>" target="_blank" rel="noopener" style="color:var(--text);text-decoration:none;"><%= n.title %></a>
                <% } else { %>
                  <%= n.title %>
                <% } %>
              </td>
              <td>
                <% if (n.impact) { %>
                  <span style="color:<%= n.impact==='High'?'#ff4f4f':n.impact==='Medium'?'#f5a623':'var(--text2)' %>;font-size:0.78rem;font-weight:600;"><%= n.impact %></span>
                <% } else if (n.sentiment) { %>
                  <span style="color:<%= n.sentiment==='Bullish'?'#00d4a0':n.sentiment==='Bearish'?'#ff4f4f':'var(--text2)' %>;font-size:0.78rem;"><%= n.sentiment %></span>
                <% } %>
              </td>
            </tr>
            <% } %>
          </tbody>
        </table>
      </div>
      <% } else { %>
      <p style="color:var(--text2);font-size:0.82rem;padding:0.5rem 0;">No news fetched yet. Updates hourly during market hours.</p>
      <% } %>
    </div>

    <!-- Daily Wins/Losses Calendar -->
    <%
    // Build current-month grid in ET. Cells show wins/losses count + net $.
    const etToday   = new Date(new Date().toLocaleString('en-US', {timeZone:'America/New_York'}));
    const calYear   = etToday.getFullYear();
    const calMonth  = etToday.getMonth();
    const monthLbl  = etToday.toLocaleString('en-US', {month:'long', year:'numeric'});
    const todayStr  = etToday.toLocaleDateString('en-CA', {timeZone:'America/New_York'});
    const firstDay  = new Date(calYear, calMonth, 1);
    const lastDay   = new Date(calYear, calMonth + 1, 0);
    const daysInMo  = lastDay.getDate();
    const startDow  = firstDay.getDay();
    const totalCells = Math.ceil((startDow + daysInMo) / 7) * 7;

    let monthWins = 0, monthLosses = 0, monthNet = 0;
    for (const k in dailyStats) {
      if (k.startsWith(calYear + '-' + String(calMonth + 1).padStart(2, '0'))) {
        monthWins   += dailyStats[k].wins;
        monthLosses += dailyStats[k].losses;
        monthNet    += dailyStats[k].net;
      }
    }
    %>
    <div class="card" style="margin-bottom:1.25rem;">
      <div class="cal-header">
        <div>
          <span class="sect-hdr" style="display:inline;">Daily Results</span>
          &nbsp;<span class="cal-month"><%= monthLbl %></span>
        </div>
        <div class="cal-legend">
          <span><span class="cal-w"><%= monthWins %>W</span> <span class="cal-l"><%= monthLosses %>L</span></span>
          <span class="<%= monthNet > 0 ? 'cal-net profit' : monthNet < 0 ? 'cal-net loss' : 'cal-net flat' %>" style="margin:0;">
            <%= monthNet >= 0 ? '+' : '' %><%= money(monthNet) %> this month
          </span>
        </div>
      </div>
      <div class="cal-grid">
        <div class="cal-dow">Sun</div><div class="cal-dow">Mon</div><div class="cal-dow">Tue</div>
        <div class="cal-dow">Wed</div><div class="cal-dow">Thu</div><div class="cal-dow">Fri</div>
        <div class="cal-dow">Sat</div>
        <% for (let i = 0; i < totalCells; i++) {
             const dayNum = i - startDow + 1;
             if (dayNum < 1 || dayNum > daysInMo) { %>
          <div class="cal-cell empty"></div>
        <%   } else {
               const dateStr = calYear + '-' + String(calMonth + 1).padStart(2, '0') + '-' + String(dayNum).padStart(2, '0');
               const stats   = dailyStats[dateStr];
               const isToday = dateStr === todayStr;
               const netCls  = stats ? (stats.net > 0 ? 'profit' : stats.net < 0 ? 'loss' : 'flat') : '';
        %>
          <div class="cal-cell <%= netCls %> <%= isToday ? 'today' : '' %> <%= stats ? 'clickable' : '' %>" <%- stats ? `data-date="${dateStr}" onclick="showDayDetails('${dateStr}')"` : '' %>>
            <div class="cal-day"><%= dayNum %></div>
            <% if (stats) { %>
              <div class="cal-wl"><span class="cal-w"><%= stats.wins %>W</span><span class="cal-l"><%= stats.losses %>L</span></div>
              <div class="cal-net <%= netCls %>"><%= stats.net >= 0 ? '+' : '' %><%= money(stats.net) %></div>
            <% } %>
          </div>
        <%   }
           } %>
      </div>
    </div>

    <!-- Backtest (nightly, recent history) -->
    <% if (typeof backtest !== 'undefined' && backtest && backtest.symbols && Object.keys(backtest.symbols).length) { %>
    <div class="card" style="margin-bottom:1.25rem;">
      <p class="sect-hdr">Backtest <span style="font-size:0.7rem;color:var(--text2);font-weight:400;">· last <%= backtest.days || 10 %> days<%= backtest.ts ? ' · ' + new Date(backtest.ts).toLocaleString('en-US',{timeZone:'America/New_York',month:'numeric',day:'numeric',hour:'2-digit',minute:'2-digit'}) + ' ET' : '' %></span></p>
      <div style="font-size:0.7rem;color:var(--text2);margin-bottom:0.7rem;">Strategy core replayed on historical bars (trailing modeled; excludes live regime/news/hour gates) — directional validation, not exact live P&amp;L.</div>
      <% Object.keys(backtest.symbols).forEach(sym => { const b = backtest.symbols[sym]; const st = b.stats || {}; const pc = (st.pnl>=0?'#00d4a0':'#ff4f4f'); %>
      <div style="margin-bottom:0.9rem;padding-bottom:0.7rem;border-bottom:1px solid var(--border);">
        <div style="font-weight:700;margin-bottom:0.25rem;"><%= sym %> <span style="font-size:0.7rem;color:var(--text2);font-weight:400;">(<%= b.bars %> bars)</span></div>
        <div style="font-size:0.82rem;margin-bottom:0.35rem;">
          <%= st.n %> trades · WR <%= st.win_rate %>% · net <span style="color:<%= pc %>;font-weight:700;font-family:'Space Mono',monospace;"><%= st.pnl>=0?'+':'' %>$<%= st.pnl %></span> · exp $<%= st.expectancy %>/trade
        </div>
        <% Object.keys(b.by_strategy||{}).forEach(s2 => { const bs=b.by_strategy[s2]; %>
          <span style="font-size:0.72rem;color:var(--text2);margin-right:1rem;"><%= s2 %>: <%= bs.n %> · WR <%= bs.wr %>% · <span style="color:<%= bs.pnl>=0?'#00d4a0':'#ff4f4f' %>;font-family:'Space Mono',monospace;">$<%= bs.pnl %></span></span>
        <% }) %>
        <% if (b.sweep && b.sweep.length) { %>
        <div style="font-size:0.7rem;color:var(--text2);margin-top:0.4rem;">
          Deviation sweep: <% b.sweep.forEach(r => { %><span style="margin-right:0.8rem;">@<%= r.threshold %>% <span style="color:<%= r.pnl>=0?'#00d4a0':'#ff4f4f' %>;font-family:'Space Mono',monospace;">$<%= r.pnl %></span></span><% }) %>
        </div>
        <% } %>
      </div>
      <% }) %>
    </div>
    <% } %>

    <!-- Trade History -->
    <div class="card" style="margin-bottom:1.25rem;">
      <details id="tradeHistoryDetails">
        <summary>
          <span class="sect-hdr" style="display:inline;">Trade History</span>
          &nbsp;<span style="font-size:0.75rem;color:var(--text2);">(<%= closedTrades ? closedTrades.length : 0 %> closed)</span>
        </summary>
        <div style="margin-top:1rem;">
          <% if (closedTrades && closedTrades.length > 0) { %>
          <div style="overflow-x:auto;">
            <table class="opt-table">
              <thead>
                <tr>
                  <th>Symbol</th><th>Mode</th><th>Strategy</th><th>Direction</th>
                  <th>Entry</th><th>Exit</th><th>P&amp;L</th><th>Fees</th><th>Reason</th><th>Date</th>
                </tr>
              </thead>
              <tbody>
                <% for (const t of closedTrades) { %>
                <tr class="<%= parseFloat(t.pnl||0) >= 0 ? 'row-profit' : 'row-loss' %>">
                  <td style="font-weight:700;"><%= t.symbol %></td>
                  <td><%- liveBadge(t) || '<span class="badge" style="opacity:0.5;">Sim</span>' %></td>
                  <td><%- stratBadge(t.strategy) %></td>
                  <td><%- dirBadge(t.direction) %></td>
                  <td style="font-family:'Space Mono',monospace;"><%= parseFloat(t.entry_price).toFixed(2) %></td>
                  <td style="font-family:'Space Mono',monospace;"><%= t.close_price != null ? parseFloat(t.close_price).toFixed(2) : '—' %></td>
                  <td style="font-family:'Space Mono',monospace;font-weight:700;">
                    <%= parseFloat(t.pnl||0) >= 0 ? '+' : '' %><%= money(t.pnl) %>
                  </td>
                  <td style="font-family:'Space Mono',monospace;color:var(--text2);font-size:0.8rem;"><%= t.fees != null ? '$' + parseFloat(t.fees).toFixed(2) : '—' %></td>
                  <td style="color:var(--text2);font-size:0.78rem;"><%= t.close_reason || '—' %></td>
                  <td style="color:var(--text2);font-size:0.78rem;">
                    <%= t.close_ts ? new Date(t.close_ts).toLocaleString('en-US', {timeZone:'America/New_York', month:'numeric', day:'numeric', year:'numeric', hour:'2-digit', minute:'2-digit', hour12:true}) + ' ET' : '—' %>
                  </td>
                </tr>
                <% } %>
              </tbody>
            </table>
          </div>
          <% } else { %>
          <p style="color:var(--text2);font-size:0.82rem;padding:0.5rem 0;">No closed trades yet.</p>
          <% } %>
        </div>
      </details>
    </div>
  </div>

  <!-- Day-detail modal -->
  <div class="day-modal-backdrop" id="dayModalBackdrop" onclick="if(event.target===this) closeDayModal()">
    <div class="day-modal">
      <div class="day-modal-header">
        <div class="day-modal-title" id="dayModalTitle">Day</div>
        <button class="day-modal-close" onclick="closeDayModal()">×</button>
      </div>
      <div class="day-modal-body" id="dayModalBody"></div>
    </div>
  </div>
  <script id="dailyStatsData" type="application/json"><%- JSON.stringify(dailyStats || {}) %></script>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r134/three.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/vanta@latest/dist/vanta.net.min.js"></script>
  <script>
    if (typeof VANTA !== 'undefined') {
      VANTA.NET({
        el: '#vanta-bg', mouseControls: true, touchControls: false, gyroControls: false,
        color: 0x00ffcc, backgroundColor: 0x020509,
        points: 16.0, maxDistance: 22.0, spacing: 12.0, showDots: true,
      });
    }
  </script>
  <script src="/nav.js?v=4"></script>
  <script>
    function toggleTrading() {
      fetch('/futures/toggle-trading', { method: 'POST' })
        .then(r => r.json())
        .then(d => { if (d.ok) location.reload(); else alert('Error: ' + d.error); })
        .catch(e => alert('Request failed: ' + e.message));
    }
    function closeTrade(id) {
      if (!confirm('Close this trade at current market price?')) return;
      fetch('/futures/close/' + id, { method: 'POST' })
        .then(r => r.text().then(t => ({ status: r.status, text: t })))
        .then(({ status, text }) => {
          try {
            const d = JSON.parse(text);
            if (d.ok) {
              const pnl = d.pnl >= 0 ? '+$' + d.pnl.toFixed(2) : '-$' + Math.abs(d.pnl).toFixed(2);
              alert('Closed at ' + d.price.toFixed(2) + '  P&L: ' + pnl);
              location.reload();
            } else {
              alert('Error: ' + (d.error || 'unknown'));
            }
          } catch (_) {
            alert('Server error ' + status + ':\n' + text.slice(0, 200));
          }
        })
        .catch(e => alert('Request failed: ' + e.message));
    }

    const _dailyStatsData = JSON.parse(document.getElementById('dailyStatsData').textContent || '{}');
    function _moneyFmt(n) {
      const v = parseFloat(n);
      return (v < 0 ? '-$' : '$') + Math.abs(v).toLocaleString('en-US', {minimumFractionDigits:2, maximumFractionDigits:2});
    }
    function _dirBadgeHTML(d) {
      if (d === 'long')  return '<span class="badge b-long">Long</span>';
      if (d === 'short') return '<span class="badge b-short">Short</span>';
      return '<span class="badge">' + (d || '?') + '</span>';
    }
    function _stratBadgeHTML(s) {
      if (s === 'vwap') return '<span class="badge b-vwap">VWAP</span>';
      if (s === 'orb')  return '<span class="badge b-orb">ORB</span>';
      return '<span class="badge">' + (s || '?') + '</span>';
    }
    function _tradeRow(t) {
      const pnlSign = t.pnl >= 0 ? '+' : '';
      const rowCls  = t.pnl >= 0 ? 'row-profit' : 'row-loss';
      const exit    = t.exit != null ? t.exit.toFixed(2) : '—';
      const timeStr = t.ts ? new Date(t.ts).toLocaleTimeString('en-US', {timeZone:'America/New_York', hour:'2-digit', minute:'2-digit', hour12:true}) + ' ET' : '—';
      return `<tr class="${rowCls}">
        <td style="font-weight:700;">${t.symbol}</td>
        <td>${_stratBadgeHTML(t.strategy)}</td>
        <td>${_dirBadgeHTML(t.direction)}</td>
        <td style="font-family:'Space Mono',monospace;">${t.entry.toFixed(2)}</td>
        <td style="font-family:'Space Mono',monospace;">${exit}</td>
        <td style="font-family:'Space Mono',monospace;font-weight:700;">${pnlSign}${_moneyFmt(t.pnl)}</td>
        <td style="color:var(--text2);font-size:0.78rem;">${t.reason || '—'}</td>
        <td style="color:var(--text2);font-size:0.78rem;">${timeStr}</td>
      </tr>`;
    }
    function _tradesTable(trades) {
      if (!trades.length) return '';
      return `<div style="overflow-x:auto;"><table class="opt-table">
        <thead><tr><th>Symbol</th><th>Strategy</th><th>Direction</th><th>Entry</th><th>Exit</th><th>P&amp;L</th><th>Reason</th><th>Time</th></tr></thead>
        <tbody>${trades.map(_tradeRow).join('')}</tbody>
      </table></div>`;
    }
    function showDayDetails(dateStr) {
      const day = _dailyStatsData[dateStr];
      if (!day) return;
      const wins   = (day.trades || []).filter(t => t.pnl > 0).sort((a, b) => b.pnl - a.pnl);
      const losses = (day.trades || []).filter(t => t.pnl < 0).sort((a, b) => a.pnl - b.pnl);
      const dateObj = new Date(dateStr + 'T12:00:00');
      const title = dateObj.toLocaleDateString('en-US', {weekday:'long', month:'long', day:'numeric', year:'numeric'});
      document.getElementById('dayModalTitle').textContent = title;
      const netCls = day.net > 0 ? 'pos' : day.net < 0 ? 'neg' : '';
      const summary = `<div class="day-modal-summary">
        <span><strong style="color:#00d4a0;">${day.wins}W</strong> ${_moneyFmt(day.win_total)}</span>
        <span><strong style="color:#ff4f4f;">${day.losses}L</strong> ${_moneyFmt(day.loss_total)}</span>
        <span>Net: <strong class="${netCls}" style="color:${day.net >= 0 ? '#00d4a0' : '#ff4f4f'};">${day.net >= 0 ? '+' : ''}${_moneyFmt(day.net)}</strong></span>
      </div>`;
      let body = summary;
      if (wins.length) {
        body += `<div class="day-section-label wins">Wins (${wins.length})</div>${_tradesTable(wins)}`;
      }
      if (losses.length) {
        body += `<div class="day-section-label losses">Losses (${losses.length})</div>${_tradesTable(losses)}`;
      }
      if (!wins.length && !losses.length) {
        body += `<p style="color:var(--text2);font-size:0.82rem;padding:0.5rem 0;">No trades on this day.</p>`;
      }
      document.getElementById('dayModalBody').innerHTML = body;
      document.getElementById('dayModalBackdrop').classList.add('open');
    }
    function closeDayModal() {
      document.getElementById('dayModalBackdrop').classList.remove('open');
    }
    document.addEventListener('keydown', e => { if (e.key === 'Escape') closeDayModal(); });

    // Live update every 3s — swap the whole content block, preserve scroll
    // position, open <details> state, and the calendar modal's data cache.
    // Skips while the day-detail modal is open so the user can read it.
    let _lastRefreshAt = Date.now();
    let _refreshInFlight = false;
    async function refreshLiveSections() {
      if (_refreshInFlight) return;
      if (document.getElementById('dayModalBackdrop').classList.contains('open')) return;
      _refreshInFlight = true;
      try {
        const r = await fetch(location.pathname, { headers: { 'Cache-Control': 'no-cache' } });
        if (!r.ok) { _refreshInFlight = false; return; }
        const html = await r.text();
        const dom  = new DOMParser().parseFromString(html, 'text/html');

        const scrollY     = window.scrollY;
        const openDetails = new Set(
          Array.from(document.querySelectorAll('details[id]'))
               .filter(d => d.open)
               .map(d => d.id)
        );

        const fresh = dom.getElementById('live-content');
        const stale = document.getElementById('live-content');
        if (fresh && stale) stale.replaceWith(fresh);

        const freshData = dom.getElementById('dailyStatsData');
        const staleData = document.getElementById('dailyStatsData');
        if (freshData && staleData) staleData.textContent = freshData.textContent;

        for (const id of openDetails) {
          const el = document.getElementById(id);
          if (el) el.open = true;
        }
        window.scrollTo(0, scrollY);
        _lastRefreshAt = Date.now();
        flashLiveDot();
      } catch (e) {
        console.warn('live refresh failed:', e);
      } finally {
        _refreshInFlight = false;
      }
    }
    function flashLiveDot() {
      const dot = document.getElementById('liveDot');
      if (!dot) return;
      dot.classList.remove('pulse');
      void dot.offsetWidth;        // force reflow so the animation restarts
      dot.classList.add('pulse');
    }
    function tickAgeIndicator() {
      const el = document.getElementById('liveAge');
      if (!el) return;
      const sec = Math.floor((Date.now() - _lastRefreshAt) / 1000);
      el.textContent = sec === 0 ? 'just now' : sec + 's ago';
    }
    setInterval(refreshLiveSections, 3000);
    setInterval(tickAgeIndicator,    1000);
  </script>
</body>
</html>
