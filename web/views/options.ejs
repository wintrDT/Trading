<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="refresh" content="60">
  <title>Options Trading — Sharp Bot</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/style.css?v=6">
  <style>
    .opt-stat-bar { display: flex; gap: 1.25rem; flex-wrap: wrap; margin-bottom: 1.5rem; }
    .opt-stat { background: var(--card); border: 1px solid var(--border); border-radius: 10px; padding: 1rem 1.4rem; min-width: 130px; }
    .opt-stat-label { font-size: 0.70rem; color: var(--text2); text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 4px; }
    .opt-stat-value { font-family: 'Space Mono', monospace; font-size: 1.2rem; font-weight: 700; }
    .opt-stat-value.pos { color: #00d4a0; }
    .opt-stat-value.neg { color: #ff4f4f; }
    .opt-table { width: 100%; border-collapse: collapse; font-size: 0.82rem; }
    .opt-table th { text-align: left; padding: 8px 12px; color: var(--text2); font-weight: 600; font-size: 0.70rem; text-transform: uppercase; letter-spacing: 0.05em; border-bottom: 1px solid var(--border); }
    .opt-table td { padding: 10px 12px; border-bottom: 1px solid rgba(255,255,255,0.04); }
    tr.row-profit td { color: #00d4a0; }
    tr.row-loss td { color: #ff4f4f; }
    tr.row-pending td { color: #f5a623; }
    .badge { display:inline-block; font-size:0.63rem; padding:2px 7px; border-radius:4px; font-weight:700; text-transform:uppercase; letter-spacing:0.04em; }
    .b-bps   { background:rgba(100,180,255,0.12); color:#64b4ff; }
    .b-ic    { background:rgba(200,130,255,0.12); color:#c882ff; }
    .b-open  { background:rgba(0,212,160,0.12);  color:#00d4a0; }
    .b-pend  { background:rgba(245,166,35,0.15); color:#f5a623; }
    .b-closed{ background:rgba(255,255,255,0.06);color:var(--text2); }
    .b-traded{ background:rgba(0,212,160,0.15);  color:#00d4a0; }
    .sect-hdr { font-size:0.82rem; font-weight:700; color:var(--accent); margin:0 0 0.75rem; text-transform:uppercase; letter-spacing:0.07em; }
    .offline-bar { background:rgba(255,79,79,0.08); border:1px solid rgba(255,79,79,0.25); border-radius:8px; padding:0.7rem 1rem; font-size:0.82rem; color:#ff4f4f; margin-bottom:1.25rem; }
    details summary { cursor:pointer; color:var(--text2); font-size:0.82rem; padding:4px 0; user-select:none; }
    details summary:hover { color:var(--text); }
    details[open] summary { color:var(--accent); }
    .pnl-bar-wrap { width:90px; height:5px; background:rgba(255,255,255,0.08); border-radius:3px; margin-top:4px; }
    .pnl-bar-fill { height:5px; border-radius:3px; transition:width 0.3s; }
    .pnl-bar-fill.profit { background:#00d4a0; }
    .pnl-bar-fill.loss   { background:#ff4f4f; }
    .sect-tab { background:rgba(255,255,255,0.05); border:1px solid var(--border); border-radius:8px; padding:8px 20px; font-size:0.82rem; font-weight:600; color:var(--text2); cursor:pointer; transition:all 0.2s; }
    .sect-tab:hover { color:var(--text); background:rgba(255,255,255,0.08); }
    .sect-tab.active { background:rgba(0,212,160,0.12); border-color:rgba(0,212,160,0.4); color:#00d4a0; }
  </style>
</head>
<body>
  <%
  function money(n) {
    if (n == null) return '—';
    const v = parseFloat(n);
    return (v < 0 ? '-$' : '$') + Math.abs(v).toLocaleString('en-US', {minimumFractionDigits:2, maximumFractionDigits:2});
  }
  function pclass(n) { return n == null ? '' : parseFloat(n) >= 0 ? 'pos' : 'neg'; }
  function stratBadge(s) {
    if (s === 'bull_put_spread') return '<span class="badge b-bps">BPS</span>';
    if (s === 'iron_condor')     return '<span class="badge b-ic">IC</span>';
    const safe = (s || '?').replace(/[<>&"]/g, c => ({'<':'&lt;','>':'&gt;','&':'&amp;','"':'&quot;'})[c]);
    return '<span class="badge b-closed">' + safe + '</span>';
  }
  function strikes(t) {
    let s = t.short_put_strike + '/' + t.long_put_strike;
    if (t.short_call_strike) s += ' · ' + t.short_call_strike + '/' + t.long_call_strike;
    return s;
  }
  function dte(expStr) {
    if (!expStr) return '—';
    const [y, m, d] = expStr.split('-').map(Number);
    const exp = new Date(y, m - 1, d);
    const now = new Date();
    now.setHours(0, 0, 0, 0);
    return Math.max(0, Math.round((exp - now) / 86400000));
  }
  %>

  <div id="vanta-bg"></div>
  <nav class="navbar">
    <div class="nav-brand">⚡ Sharp Bot</div>
    <div class="nav-links">
      <div class="nav-dropdown">
        <button class="nav-dropdown-trigger">Predictions <span class="dd-arrow">▼</span></button>
        <div class="nav-dropdown-menu">
          <a href="/">Dashboard</a>
          <a href="/history">History</a>
          <a href="/spreads">Spreads</a>
          <a href="/portfolio">Portfolio</a>
        </div>
      </div>
      <div class="nav-dropdown">
        <button class="nav-dropdown-trigger active">Trading <span class="dd-arrow">▼</span></button>
        <div class="nav-dropdown-menu">
          <a href="/options" class="active">Options</a>
          <a href="/futures">Futures</a>
          <a href="/crypto">Crypto</a>
        </div>
      </div>
      <a href="/settings">Settings</a>
      <% if (user.role === 'admin') { %><a href="/admin">Admin</a><% } %>
    </div>
    <div class="nav-right">
      <span class="nav-user">@<%= user.username %></span>
      <a href="/auth/logout" class="btn-logout">Logout</a>
    </div>
  </nav>

  <div class="container" style="padding-top: 2rem;">

    <div class="page-header">
      <h2>Options Trading</h2>
    </div>

    <% if (!botOnline) { %>
    <div class="offline-bar">Bot offline — start the Python bot to populate data.</div>
    <% } %>

    <!-- Account Summary -->
    <div class="opt-stat-bar">
      <div class="opt-stat">
        <div class="opt-stat-label">Net Liq</div>
        <div class="opt-stat-value <%= accountSnap ? pclass(accountSnap.net_liq) : '' %>">
          <%= accountSnap ? money(accountSnap.net_liq) : '—' %>
        </div>
      </div>
      <div class="opt-stat">
        <div class="opt-stat-label">Cash</div>
        <div class="opt-stat-value <%= accountSnap ? pclass(accountSnap.cash) : '' %>">
          <%= accountSnap ? money(accountSnap.cash) : '—' %>
        </div>
      </div>
      <div class="opt-stat">
        <div class="opt-stat-label">Open P&amp;L</div>
        <div class="opt-stat-value <%= accountSnap ? pclass(accountSnap.open_pnl) : '' %>">
          <%= accountSnap ? money(accountSnap.open_pnl) : '—' %>
        </div>
      </div>
      <div class="opt-stat">
        <div class="opt-stat-label">Realized Today</div>
        <div class="opt-stat-value <%= accountSnap ? pclass(accountSnap.realized_pnl_today) : '' %>">
          <%= accountSnap ? money(accountSnap.realized_pnl_today) : '—' %>
        </div>
      </div>
      <div class="opt-stat">
        <div class="opt-stat-label">All-time P&amp;L</div>
        <div class="opt-stat-value <%= allTimePnl != null ? pclass(allTimePnl) : '' %>">
          <%= allTimePnl != null ? money(allTimePnl) : '—' %>
        </div>
      </div>
    </div>

    <!-- Section tabs -->
    <div style="display:flex;gap:8px;margin-bottom:1.25rem">
      <button class="sect-tab active" onclick="switchTab('premium',this)">Premium Selling</button>
      <button class="sect-tab" onclick="switchTab('0dte',this)">0DTE Trading</button>
    </div>

    <!-- PREMIUM SELLING SECTION -->
    <div id="tab-premium">

    <!-- Manual Paper Trade (Simulation mode only) -->
    <% if (typeof simMode !== 'undefined' && simMode) { %>
    <div class="card" style="margin-bottom:1.25rem">
      <p class="sect-hdr">Manual Paper Trade — Premium</p>
      <div style="display:flex;flex-wrap:wrap;gap:10px;align-items:flex-end">
        <div>
          <div style="font-size:11px;color:var(--text2);margin-bottom:4px">Symbol</div>
          <select id="mt-underlying" class="gen-input" style="width:90px;font-size:13px">
            <option>SPY</option><option>QQQ</option><option>IWM</option>
          </select>
        </div>
        <div>
          <div style="font-size:11px;color:var(--text2);margin-bottom:4px">Strategy</div>
          <select id="mt-strategy" class="gen-input" style="width:130px;font-size:13px" onchange="toggleCallStrikes()">
            <option value="bull_put_spread">Bull Put Spread</option>
            <option value="iron_condor">Iron Condor</option>
          </select>
        </div>
        <div>
          <div style="font-size:11px;color:var(--text2);margin-bottom:4px">Expiration</div>
          <input type="date" id="mt-expiration" class="gen-input" style="width:140px;font-size:13px">
        </div>
        <div>
          <div style="font-size:11px;color:var(--text2);margin-bottom:4px">Short Put</div>
          <input type="number" id="mt-short-put" class="gen-input" style="width:80px;font-size:13px" placeholder="530">
        </div>
        <div>
          <div style="font-size:11px;color:var(--text2);margin-bottom:4px">Long Put</div>
          <input type="number" id="mt-long-put" class="gen-input" style="width:80px;font-size:13px" placeholder="525">
        </div>
        <div id="call-strikes" style="display:none;gap:10px;align-items:flex-end">
          <div>
            <div style="font-size:11px;color:var(--text2);margin-bottom:4px">Short Call</div>
            <input type="number" id="mt-short-call" class="gen-input" style="width:80px;font-size:13px" placeholder="560">
          </div>
          <div>
            <div style="font-size:11px;color:var(--text2);margin-bottom:4px">Long Call</div>
            <input type="number" id="mt-long-call" class="gen-input" style="width:80px;font-size:13px" placeholder="565">
          </div>
        </div>
        <div>
          <div style="font-size:11px;color:var(--text2);margin-bottom:4px">Credit</div>
          <input type="number" id="mt-credit" class="gen-input" step="0.01" style="width:80px;font-size:13px" placeholder="1.50">
        </div>
        <div>
          <div style="font-size:11px;color:var(--text2);margin-bottom:4px">Contracts</div>
          <input type="number" id="mt-contracts" class="gen-input" style="width:70px;font-size:13px" value="1" min="1">
        </div>
        <div>
          <button class="btn-sm" onclick="submitManualTrade()" style="font-size:12px;padding:9px 18px">Place Paper Trade</button>
        </div>
      </div>
      <div id="mt-result" style="font-size:12px;margin-top:8px;min-height:18px"></div>
    </div>
    <% } %>

    <!-- Open Positions — Premium -->
    <div class="card" style="margin-bottom: 1.25rem;">
      <p class="sect-hdr">Open Positions</p>
      <% if (openTrades && openTrades.length > 0) { %>
      <div style="overflow-x: auto;">
        <table class="opt-table">
          <thead>
            <tr>
              <th>Symbol</th>
              <th>Strategy</th>
              <th>Strikes</th>
              <th>Expiration</th>
              <th>DTE</th>
              <th>Entry Credit</th>
              <th>P&amp;L %</th>
              <th>Target</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
            <% for (const t of openTrades) { %>
            <%
              const entry = parseFloat(t.entry_credit) || 0;
              const mark  = t.current_mark != null ? parseFloat(t.current_mark) : null;
              const pnlPct = (mark != null && entry > 0) ? Math.round((entry - mark) / entry * 100) : null;
              const barPct = pnlPct != null ? Math.min(100, Math.max(0, pnlPct)) : 0;
              const rowClass = t.status === 'pending' ? 'row-pending' : (pnlPct != null && pnlPct < -100 ? 'row-loss' : '');
            %>
            <tr class="<%= rowClass %>">
              <td><%= t.underlying %></td>
              <td><%- stratBadge(t.strategy) %></td>
              <td><%= strikes(t) %></td>
              <td><%= t.expiration %></td>
              <td><%= dte(t.expiration) %></td>
              <td><%= money(t.entry_credit) %></td>
              <td style="font-family:'Space Mono',monospace;">
                <% if (pnlPct != null) { %>
                  <span style="color:<%= pnlPct >= 0 ? '#00d4a0' : '#ff4f4f' %>"><%= pnlPct >= 0 ? '+' : '' %><%= pnlPct %>%</span>
                  <div class="pnl-bar-wrap">
                    <div class="pnl-bar-fill <%= pnlPct >= 0 ? 'profit' : 'loss' %>" style="width:<%= barPct %>%"></div>
                  </div>
                <% } else { %>—<% } %>
              </td>
              <td style="color:var(--text2);font-size:0.78rem;">50% / 200%<br><span style="font-size:0.70rem;">close &lt;7 DTE</span></td>
              <td>
                <% if (t.status === 'pending') { %>
                  <span class="badge b-pend">Pending</span>
                <% } else { %>
                  <span class="badge b-open">Open</span>
                <% } %>
              </td>
            </tr>
            <% } %>
          </tbody>
        </table>
      </div>
      <% } else { %>
      <p style="color: var(--text2); font-size: 0.82rem; padding: 0.5rem 0;">No open positions.</p>
      <% } %>
    </div>

    <!-- Scanner Feed — Premium -->
    <div class="card" style="margin-bottom: 1.25rem;">
      <p class="sect-hdr">Scanner Feed</p>
      <% if (recentScans && recentScans.length > 0) { %>
      <div style="overflow-x: auto;">
        <table class="opt-table">
          <thead>
            <tr>
              <th>Time</th>
              <th>Symbol</th>
              <th>Strategy</th>
              <th>Strikes</th>
              <th>Credit</th>
              <th>IV Rank</th>
              <th>Delta</th>
              <th>DTE</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% const feedScans = recentScans; %>
            <% for (const s of feedScans) { %>
            <tr>
              <td style="color: var(--text2); font-family: 'Space Mono', monospace; font-size: 0.75rem;"><%= s.ts ? new Date(s.ts).toLocaleTimeString([], {hour:'2-digit', minute:'2-digit'}) : '—' %></td>
              <td><%= s.underlying %></td>
              <td><%- stratBadge(s.strategy) %></td>
              <td><%= strikes(s) %></td>
              <td><%= money(s.credit) %></td>
              <td><%= s.iv_rank != null ? parseFloat(s.iv_rank).toFixed(1) + '%' : '—' %></td>
              <td><%= s.delta != null ? parseFloat(s.delta).toFixed(2) : '—' %></td>
              <td><%= s.expiration ? dte(s.expiration) : '—' %></td>
              <td>
                <% if (s.traded == 1) { %>
                  <span class="badge b-traded">Traded</span>
                <% } else if (typeof simMode !== 'undefined' && simMode) { %>
                  <button class="btn-sm" style="font-size:11px;padding:4px 10px" data-scan="<%- JSON.stringify(s).replace(/"/g, '&quot;') %>" onclick="fillFromScan(this)">Trade This</button>
                <% } %>
              </td>
            </tr>
            <% } %>
          </tbody>
        </table>
      </div>
      <% } else { %>
      <p style="color: var(--text2); font-size: 0.82rem; padding: 0.5rem 0;">No scans yet.</p>
      <% } %>
    </div>

    <!-- Trade History — Premium -->
    <div class="card" style="margin-bottom: 1.25rem;">
      <details>
        <summary><span class="sect-hdr" style="display:inline;">Trade History</span> &nbsp;<span style="font-size:0.75rem; color:var(--text2);">(<%= closedTrades ? closedTrades.length : 0 %> closed)</span></summary>
        <div style="margin-top: 1rem;">
          <% if (closedTrades && closedTrades.length > 0) { %>
          <div style="overflow-x: auto;">
            <table class="opt-table">
              <thead>
                <tr>
                  <th>Symbol</th><th>Strategy</th><th>Strikes</th><th>Expiration</th>
                  <th>Entry</th><th>Close</th><th>P&amp;L</th><th>Reason</th><th>Date</th>
                </tr>
              </thead>
              <tbody>
                <% for (const t of closedTrades) { %>
                <% const pnl = ((parseFloat(t.entry_credit)||0)-(parseFloat(t.close_credit)||0))*(parseInt(t.contracts)||1)*100; %>
                <tr class="<%= pnl >= 0 ? 'row-profit' : 'row-loss' %>">
                  <td><%= t.underlying %></td><td><%- stratBadge(t.strategy) %></td>
                  <td><%= strikes(t) %></td><td><%= t.expiration %></td>
                  <td><%= money(t.entry_credit) %></td><td><%= money(t.close_credit) %></td>
                  <td style="font-family:'Space Mono',monospace;font-weight:700;"><%= pnl>=0?'+':'' %><%= money(pnl) %></td>
                  <td style="color:var(--text2);font-size:0.78rem;"><%= t.close_reason||'—' %></td>
                  <td style="color:var(--text2);font-size:0.78rem;"><%= t.close_ts?new Date(t.close_ts).toLocaleDateString():'—' %></td>
                </tr>
                <% } %>
              </tbody>
            </table>
          </div>
          <% } else { %>
          <p style="color: var(--text2); font-size: 0.82rem; padding: 0.5rem 0;">No closed trades yet.</p>
          <% } %>
        </div>
      </details>
    </div>

    </div><!-- end #tab-premium -->

    <!-- 0DTE TRADING SECTION -->
    <div id="tab-0dte" style="display:none">

    <!-- Manual 0DTE Paper Trade (Simulation mode only) -->
    <% if (typeof simMode !== 'undefined' && simMode) { %>
    <div class="card" style="margin-bottom:1.25rem">
      <p class="sect-hdr">Manual Paper Trade — 0DTE</p>
      <div style="display:flex;flex-wrap:wrap;gap:10px;align-items:flex-end">
        <div>
          <div style="font-size:11px;color:var(--text2);margin-bottom:4px">Symbol</div>
          <select id="mt0-underlying" class="gen-input" style="width:90px;font-size:13px">
            <option>SPY</option><option>QQQ</option><option>IWM</option>
          </select>
        </div>
        <div>
          <div style="font-size:11px;color:var(--text2);margin-bottom:4px">Strategy</div>
          <select id="mt0-strategy" class="gen-input" style="width:130px;font-size:13px" onchange="toggleCallStrikes0()">
            <option value="iron_condor">Iron Condor</option>
            <option value="bull_put_spread">Bull Put Spread</option>
          </select>
        </div>
        <div>
          <div style="font-size:11px;color:var(--text2);margin-bottom:4px">Expiration</div>
          <input type="date" id="mt0-expiration" class="gen-input" style="width:140px;font-size:13px">
        </div>
        <div>
          <div style="font-size:11px;color:var(--text2);margin-bottom:4px">Short Put</div>
          <input type="number" id="mt0-short-put" class="gen-input" style="width:80px;font-size:13px" placeholder="530">
        </div>
        <div>
          <div style="font-size:11px;color:var(--text2);margin-bottom:4px">Long Put</div>
          <input type="number" id="mt0-long-put" class="gen-input" style="width:80px;font-size:13px" placeholder="529">
        </div>
        <div id="call-strikes-0dte" style="display:flex;gap:10px;align-items:flex-end">
          <div>
            <div style="font-size:11px;color:var(--text2);margin-bottom:4px">Short Call</div>
            <input type="number" id="mt0-short-call" class="gen-input" style="width:80px;font-size:13px" placeholder="535">
          </div>
          <div>
            <div style="font-size:11px;color:var(--text2);margin-bottom:4px">Long Call</div>
            <input type="number" id="mt0-long-call" class="gen-input" style="width:80px;font-size:13px" placeholder="536">
          </div>
        </div>
        <div>
          <div style="font-size:11px;color:var(--text2);margin-bottom:4px">Credit</div>
          <input type="number" id="mt0-credit" class="gen-input" step="0.01" style="width:80px;font-size:13px" placeholder="0.50">
        </div>
        <div>
          <div style="font-size:11px;color:var(--text2);margin-bottom:4px">Contracts</div>
          <input type="number" id="mt0-contracts" class="gen-input" style="width:70px;font-size:13px" value="1" min="1">
        </div>
        <div>
          <button class="btn-sm" onclick="submitManualTrade0dte()" style="font-size:12px;padding:9px 18px">Place 0DTE Trade</button>
        </div>
      </div>
      <div id="mt0-result" style="font-size:12px;margin-top:8px;min-height:18px"></div>
    </div>
    <% } %>

    <!-- Open Positions — 0DTE -->
    <div class="card" style="margin-bottom: 1.25rem;">
      <p class="sect-hdr">Open 0DTE Positions</p>
      <% if (openTrades0dte && openTrades0dte.length > 0) { %>
      <div style="overflow-x: auto;">
        <table class="opt-table">
          <thead>
            <tr>
              <th>Symbol</th><th>Strategy</th><th>Strikes</th><th>Expiration</th>
              <th>Entry Credit</th><th>P&amp;L %</th><th>Exit Rules</th><th>Status</th>
            </tr>
          </thead>
          <tbody>
            <% for (const t of openTrades0dte) { %>
            <%
              const entry0 = parseFloat(t.entry_credit) || 0;
              const mark0  = t.current_mark != null ? parseFloat(t.current_mark) : null;
              const pnl0   = (mark0 != null && entry0 > 0) ? Math.round((entry0 - mark0) / entry0 * 100) : null;
              const bar0   = pnl0 != null ? Math.min(100, Math.max(0, pnl0)) : 0;
            %>
            <tr class="<%= t.status==='pending'?'row-pending':(pnl0!=null&&pnl0<-50?'row-loss':'') %>">
              <td><%= t.underlying %></td>
              <td><%- stratBadge(t.strategy) %></td>
              <td><%= strikes(t) %></td>
              <td><%= t.expiration %></td>
              <td><%= money(t.entry_credit) %></td>
              <td style="font-family:'Space Mono',monospace;">
                <% if (pnl0 != null) { %>
                  <span style="color:<%= pnl0>=0?'#00d4a0':'#ff4f4f' %>"><%= pnl0>=0?'+':'' %><%= pnl0 %>%</span>
                  <div class="pnl-bar-wrap"><div class="pnl-bar-fill <%= pnl0>=0?'profit':'loss' %>" style="width:<%= bar0 %>%"></div></div>
                <% } else { %>—<% } %>
              </td>
              <td style="color:var(--text2);font-size:0.78rem;">50% profit / 100% stop<br><span style="font-size:0.70rem;">force-close 3:00 PM</span></td>
              <td><span class="badge <%= t.status==='pending'?'b-pend':'b-open' %>"><%= t.status==='pending'?'Pending':'Open' %></span></td>
            </tr>
            <% } %>
          </tbody>
        </table>
      </div>
      <% } else { %>
      <p style="color: var(--text2); font-size: 0.82rem; padding: 0.5rem 0;">No open 0DTE positions.</p>
      <% } %>
    </div>

    <!-- Scanner Feed — 0DTE -->
    <div class="card" style="margin-bottom: 1.25rem;">
      <p class="sect-hdr">0DTE Scanner Feed</p>
      <% if (recentScans0dte && recentScans0dte.length > 0) { %>
      <div style="overflow-x: auto;">
        <table class="opt-table">
          <thead>
            <tr>
              <th>Time</th><th>Symbol</th><th>Strategy</th><th>Strikes</th>
              <th>Credit</th><th>Delta</th><th></th>
            </tr>
          </thead>
          <tbody>
            <% for (const s of recentScans0dte) { %>
            <tr>
              <td style="color:var(--text2);font-family:'Space Mono',monospace;font-size:0.75rem;"><%= s.ts?new Date(s.ts).toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'}):'—' %></td>
              <td><%= s.underlying %></td>
              <td><%- stratBadge(s.strategy) %></td>
              <td><%= strikes(s) %></td>
              <td><%= money(s.credit) %></td>
              <td><%= s.delta!=null?parseFloat(s.delta).toFixed(2):'—' %></td>
              <td>
                <% if (s.traded==1) { %>
                  <span class="badge b-traded">Traded</span>
                <% } else if (typeof simMode!=='undefined'&&simMode) { %>
                  <button class="btn-sm" style="font-size:11px;padding:4px 10px" data-scan="<%- JSON.stringify(s).replace(/"/g,'&quot;') %>" onclick="fillFromScan0dte(this)">Trade This</button>
                <% } %>
              </td>
            </tr>
            <% } %>
          </tbody>
        </table>
      </div>
      <% } else { %>
      <p style="color: var(--text2); font-size: 0.82rem; padding: 0.5rem 0;">No 0DTE scans yet. Scanner runs 9:45–11:00 AM and 1:30–2:30 PM ET.</p>
      <% } %>
    </div>

    <!-- Trade History — 0DTE -->
    <div class="card" style="margin-bottom: 1.25rem;">
      <details>
        <summary><span class="sect-hdr" style="display:inline;">0DTE Trade History</span> &nbsp;<span style="font-size:0.75rem;color:var(--text2);">(<%= closedTrades0dte?closedTrades0dte.length:0 %> closed)</span></summary>
        <div style="margin-top:1rem;">
          <% if (closedTrades0dte && closedTrades0dte.length > 0) { %>
          <div style="overflow-x:auto;">
            <table class="opt-table">
              <thead>
                <tr>
                  <th>Symbol</th><th>Strategy</th><th>Strikes</th><th>Entry</th>
                  <th>Close</th><th>P&amp;L</th><th>Reason</th><th>Date</th>
                </tr>
              </thead>
              <tbody>
                <% for (const t of closedTrades0dte) { %>
                <% const pnl0h=((parseFloat(t.entry_credit)||0)-(parseFloat(t.close_credit)||0))*(parseInt(t.contracts)||1)*100; %>
                <tr class="<%= pnl0h>=0?'row-profit':'row-loss' %>">
                  <td><%= t.underlying %></td><td><%- stratBadge(t.strategy) %></td>
                  <td><%= strikes(t) %></td>
                  <td><%= money(t.entry_credit) %></td><td><%= money(t.close_credit) %></td>
                  <td style="font-family:'Space Mono',monospace;font-weight:700;"><%= pnl0h>=0?'+':'' %><%= money(pnl0h) %></td>
                  <td style="color:var(--text2);font-size:0.78rem;"><%= t.close_reason||'—' %></td>
                  <td style="color:var(--text2);font-size:0.78rem;"><%= t.close_ts?new Date(t.close_ts).toLocaleDateString():'—' %></td>
                </tr>
                <% } %>
              </tbody>
            </table>
          </div>
          <% } else { %>
          <p style="color:var(--text2);font-size:0.82rem;padding:0.5rem 0;">No closed 0DTE trades yet.</p>
          <% } %>
        </div>
      </details>
    </div>

    </div><!-- end #tab-0dte -->

  </div>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r134/three.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/vanta@latest/dist/vanta.net.min.js"></script>
  <script>
    if (typeof VANTA !== 'undefined') {
      VANTA.NET({
        el: '#vanta-bg',
        mouseControls: true,
        touchControls: false,
        gyroControls: false,
        color: 0x00ffcc,
        backgroundColor: 0x020509,
        points: 16.0,
        maxDistance: 22.0,
        spacing: 12.0,
        showDots: true,
      });
    }
  </script>
  <script src="/nav.js?v=4"></script>
  <script>
    function switchTab(name, el) {
      document.getElementById('tab-premium').style.display = name === 'premium' ? '' : 'none';
      document.getElementById('tab-0dte').style.display    = name === '0dte'    ? '' : 'none';
      document.querySelectorAll('.sect-tab').forEach(t => t.classList.remove('active'));
      el.classList.add('active');
    }

    function fillFromScan(btn) {
      const s = JSON.parse(btn.dataset.scan);
      document.getElementById('mt-underlying').value = s.underlying;
      document.getElementById('mt-strategy').value   = s.strategy;
      document.getElementById('mt-expiration').value = s.expiration;
      document.getElementById('mt-short-put').value  = s.short_put_strike;
      document.getElementById('mt-long-put').value   = s.long_put_strike;
      document.getElementById('mt-short-call').value = s.short_call_strike || '';
      document.getElementById('mt-long-call').value  = s.long_call_strike  || '';
      document.getElementById('mt-credit').value     = s.credit;
      toggleCallStrikes();
      document.getElementById('mt-underlying').closest('.card').scrollIntoView({ behavior: 'smooth' });
    }
    function toggleCallStrikes() {
      const isIC = document.getElementById('mt-strategy').value === 'iron_condor';
      document.getElementById('call-strikes').style.display = isIC ? 'flex' : 'none';
    }
    function toggleCallStrikes0() {
      const isIC = document.getElementById('mt0-strategy').value === 'iron_condor';
      document.getElementById('call-strikes-0dte').style.display = isIC ? 'flex' : 'none';
    }
    function fillFromScan0dte(btn) {
      const s = JSON.parse(btn.dataset.scan);
      document.getElementById('mt0-underlying').value  = s.underlying;
      document.getElementById('mt0-strategy').value    = s.strategy;
      document.getElementById('mt0-expiration').value  = s.expiration;
      document.getElementById('mt0-short-put').value   = s.short_put_strike;
      document.getElementById('mt0-long-put').value    = s.long_put_strike;
      document.getElementById('mt0-short-call').value  = s.short_call_strike || '';
      document.getElementById('mt0-long-call').value   = s.long_call_strike  || '';
      document.getElementById('mt0-credit').value      = s.credit;
      toggleCallStrikes0();
    }
    async function submitManualTrade0dte() {
      const result = document.getElementById('mt0-result');
      const body = {
        underlying:  document.getElementById('mt0-underlying').value,
        strategy:    document.getElementById('mt0-strategy').value,
        expiration:  document.getElementById('mt0-expiration').value,
        short_put:   document.getElementById('mt0-short-put').value,
        long_put:    document.getElementById('mt0-long-put').value,
        short_call:  document.getElementById('mt0-short-call').value,
        long_call:   document.getElementById('mt0-long-call').value,
        credit:      document.getElementById('mt0-credit').value,
        contracts:   document.getElementById('mt0-contracts').value,
        trade_type:  '0dte',
      };
      if (!body.expiration || !body.short_put || !body.long_put || !body.credit) {
        result.innerHTML = '<span style="color:var(--yellow)">Fill in all required fields.</span>';
        return;
      }
      result.innerHTML = '<span style="color:var(--text2)">Placing…</span>';
      try {
        const res = await fetch('/options/manual-trade', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body),
        });
        const data = await res.json();
        if (data.ok) {
          result.innerHTML = '<span style="color:var(--green)">✅ Trade recorded — page will refresh.</span>';
          setTimeout(() => location.reload(), 1500);
        } else {
          result.innerHTML = `<span style="color:var(--red)">❌ ${data.error}</span>`;
        }
      } catch (e) {
        result.innerHTML = `<span style="color:var(--red)">❌ ${e.message}</span>`;
      }
    }

    async function submitManualTrade() {
      const result = document.getElementById('mt-result');
      const body = {
        underlying:  document.getElementById('mt-underlying').value,
        strategy:    document.getElementById('mt-strategy').value,
        expiration:  document.getElementById('mt-expiration').value,
        short_put:   document.getElementById('mt-short-put').value,
        long_put:    document.getElementById('mt-long-put').value,
        short_call:  document.getElementById('mt-short-call').value,
        long_call:   document.getElementById('mt-long-call').value,
        credit:      document.getElementById('mt-credit').value,
        contracts:   document.getElementById('mt-contracts').value,
      };
      if (!body.expiration || !body.short_put || !body.long_put || !body.credit) {
        result.innerHTML = '<span style="color:var(--yellow)">Fill in all required fields.</span>';
        return;
      }
      result.innerHTML = '<span style="color:var(--text2)">Placing…</span>';
      try {
        const res = await fetch('/options/manual-trade', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body),
        });
        const data = await res.json();
        if (data.ok) {
          result.innerHTML = '<span style="color:var(--green)">✅ Trade recorded — page will refresh.</span>';
          setTimeout(() => location.reload(), 1500);
        } else {
          result.innerHTML = `<span style="color:var(--red)">❌ ${data.error}</span>`;
        }
      } catch (e) {
        result.innerHTML = `<span style="color:var(--red)">❌ ${e.message}</span>`;
      }
    }
  </script>
</body>
</html>
